---
import { getTranslations, type Locale } from "../i18n";
import { CURRENCIES } from "../lib/couple-expenses";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props as Props;
const copy = getTranslations(locale).coupleExpenses;
const titleId = "couple-expense-calculator-title";
const resultsTitleId = "couple-expense-calculator-results-title";

const people = [
    { key: "a" as const, badge: "A", fallback: copy.personA },
    { key: "b" as const, badge: "B", fallback: copy.personB },
];

const expenseSections = [
    {
        key: "fixed" as const,
        title: copy.fixedTitle,
        hint: copy.fixedHint,
        add: copy.addFixed,
    },
    {
        key: "monthly" as const,
        title: copy.monthlyTitle,
        hint: copy.monthlyHint,
        add: copy.addMonthly,
    },
];
---

<section
    class="calc"
    data-couple-calculator
    data-locale={locale}
    data-person-a={copy.personA}
    data-person-b={copy.personB}
    data-zero-income={copy.zeroIncome}
    data-over-budget={copy.overBudget}
    data-saved={copy.saved}
    data-save-error={copy.saveError}
    data-placeholder-fixed={copy.expenseNamePlaceholder}
    data-placeholder-monthly={copy.expenseNamePlaceholderMonthly}
    aria-labelledby={titleId}
>
    <header class="calc-header">
        <h2 class="calc-title" id={titleId}>
            {copy.title}
        </h2>
        <p class="calc-subtitle">{copy.subtitle}</p>
    </header>

    <div class="calc-trust">
        <p class="calc-privacy-note">
            <svg
                width="12"
                height="12"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
            >
                <rect
                    x="3.25"
                    y="7"
                    width="9.5"
                    height="6.75"
                    rx="2"
                    stroke="currentColor"
                    stroke-width="1.2"
                ></rect>
                <path
                    d="M5.5 7V5.25a2.5 2.5 0 015 0V7"
                    stroke="currentColor"
                    stroke-width="1.2"
                    stroke-linecap="round"
                ></path>
            </svg>
            <span>{copy.privacyNote}</span>
        </p>

        <span class="save-status" data-save-status>
            <span class="save-dot" aria-hidden="true"></span>
            <span data-save-label>{copy.saved}</span>
        </span>
    </div>

    <p class="calc-example-note" data-example-note hidden>
        <span class="example-dot" aria-hidden="true"></span>
        <span>{copy.exampleNote}</span>
    </p>

    <div class="calc-toolbar">
        <label class="currency-field">
            <span class="field-label">{copy.currency}</span>
            <select data-currency>
                {CURRENCIES.map((currency) => (
                    <option value={currency.code}>
                        {currency.code} · {currency.symbol}
                    </option>
                ))}
            </select>
        </label>
    </div>

    <div class="people-grid">
        {people.map((person) => (
            <div class="person-card" data-person={person.key}>
                <div class="person-top">
                    <span class="person-badge" aria-hidden="true">
                        {person.badge}
                    </span>
                    <label class="name-field">
                        <span class="sr-only">{copy.name}</span>
                        <input
                            type="text"
                            data-name={person.key}
                            placeholder={
                                person.key === "a"
                                    ? copy.namePlaceholderA
                                    : copy.namePlaceholderB
                            }
                            autocomplete="off"
                            maxlength="32"
                        />
                    </label>
                </div>

                <label class="income-field">
                    <span class="field-label">{copy.income}</span>
                    <span class="input-shell">
                        <span
                            class="currency-symbol"
                            data-currency-symbol
                            aria-hidden="true"
                        >
                            €
                        </span>
                        <input
                            type="number"
                            data-income={person.key}
                            inputmode="decimal"
                            min="0"
                            step="0.01"
                            placeholder="0"
                        />
                    </span>
                </label>
            </div>
        ))}
    </div>

    <div class="expenses-grid">
        {expenseSections.map((section) => (
            <section class="expense-card">
                <header class="expense-head">
                    <div>
                        <h3>{section.title}</h3>
                        <p class="expense-hint">{section.hint}</p>
                    </div>
                    <span class="expense-total" data-list-total={section.key}>
                        —
                    </span>
                </header>

                <div class="expense-list" data-list={section.key}></div>

                <p class="expense-empty" data-empty={section.key}>
                    {copy.noExpenses}
                </p>

                <button
                    type="button"
                    class="add-expense"
                    data-add={section.key}
                >
                    <span aria-hidden="true">+</span>
                    {section.add}
                </button>
            </section>
        ))}
    </div>

    <section class="results" aria-labelledby={resultsTitleId}>
        <h3 class="results-title" id={resultsTitleId}>
            {copy.resultsTitle}
        </h3>

        <div class="summary-grid">
            <div class="summary-tile">
                <span>{copy.incomeTotal}</span>
                <strong data-total-income>—</strong>
            </div>
            <div class="summary-tile">
                <span>{copy.expensesTotal}</span>
                <strong data-total-expenses>—</strong>
            </div>
            <div class="summary-tile">
                <span>{copy.savingsRate}</span>
                <strong data-savings-rate>—</strong>
                <small>
                    {copy.equalEffort} <span data-effort>—</span>
                </small>
            </div>
            <div class="summary-tile">
                <span>{copy.combinedSavings}</span>
                <strong data-combined-savings>—</strong>
            </div>
        </div>

        <p class="notice" data-notice aria-live="polite" hidden></p>

        <div class="result-grid">
            {people.map((person) => (
                <article class="result-card" data-person-result={person.key}>
                    <div class="result-head">
                        <span class="person-badge" aria-hidden="true">
                            {person.badge}
                        </span>
                        <h4 data-result-name={person.key}>{person.fallback}</h4>
                        <span class="bill-share">
                            <span data-bill-share={person.key}>—</span>{" "}
                            {copy.ofBill}
                        </span>
                    </div>

                    <div class="result-main">
                        <strong
                            class="result-amount"
                            data-contribution={person.key}
                        >
                            —
                        </strong>
                        <span class="result-caption">{copy.paysPerMonth}</span>
                    </div>

                    <div class="result-foot">
                        <div>
                            <span>{copy.keeps}</span>
                            <strong data-savings={person.key}>—</strong>
                        </div>
                    </div>
                </article>
            ))}
        </div>

        <div class="split">
            <div class="split-head">
                <span>{copy.householdSplit}</span>
                <span class="split-legend" data-split-legend>
                    —
                </span>
            </div>
            <div class="split-track" aria-hidden="true">
                <span class="split-a" data-split-a></span>
                <span class="split-b" data-split-b></span>
            </div>
        </div>

        <div class="split">
            <div class="split-head">
                <span>{copy.incomeSplit}</span>
                <span class="split-legend" data-income-split>
                    —
                </span>
            </div>
            <div class="split-track" aria-hidden="true">
                <span class="split-contribution" data-split-contribution></span>
                <span class="split-savings" data-split-savings></span>
            </div>

            <div class="calc-legend">
                <span>
                    <i class="legend-swatch legend-swatch--contribution"></i>
                    {copy.contribution}
                </span>
                <span>
                    <i class="legend-swatch legend-swatch--savings"></i>
                    {copy.savings}
                </span>
            </div>
        </div>
    </section>

    <template data-expense-template>
        <div class="expense-row" data-expense-row>
            <input
                class="expense-name-input"
                type="text"
                data-expense-name
                placeholder={copy.expenseNamePlaceholder}
                aria-label={copy.expenseName}
                autocomplete="off"
                maxlength="48"
            />
            <span class="input-shell expense-amount-input">
                <span
                    class="currency-symbol"
                    data-currency-symbol
                    aria-hidden="true"
                >
                    €
                </span>
                <input
                    type="number"
                    data-expense-amount
                    inputmode="decimal"
                    min="0"
                    step="0.01"
                    placeholder="0"
                    aria-label={copy.amount}
                />
            </span>
            <button
                class="expense-remove"
                type="button"
                data-expense-remove
                aria-label={copy.removeExpense}
                title={copy.removeExpense}
            >
                <svg
                    width="15"
                    height="15"
                    viewBox="0 0 16 16"
                    fill="none"
                    aria-hidden="true"
                >
                    <path
                        d="M4 4l8 8M12 4l-8 8"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                    ></path>
                </svg>
            </button>
        </div>
    </template>
</section>

<script>
    import {
        calculateSplit,
        createExampleState,
        createExpense,
        formatMoney,
        formatPercent,
        getCurrencySymbol,
        isExampleState,
        normalizeState,
        parseAmount,
        sumExpenses,
        type CoupleExpenseState,
        type PersonSplit,
    } from "../lib/couple-expenses";

    const STORAGE_KEY = "kakeibo:couple-expenses:v1";
    const SAVE_DELAY = 250;

    document
        .querySelectorAll<HTMLElement>("[data-couple-calculator]")
        .forEach(setupCalculator);

    function setupCalculator(root: HTMLElement) {
        const locale = root.dataset.locale === "es" ? "es" : "en";
        const fallbackA = root.dataset.personA ?? "Person 1";
        const fallbackB = root.dataset.personB ?? "Person 2";
        const zeroIncome = root.dataset.zeroIncome ?? "";
        const overBudget = root.dataset.overBudget ?? "";
        const savedLabel = root.dataset.saved ?? "";
        const saveErrorLabel = root.dataset.saveError ?? "";
        const placeholderFixed = root.dataset.placeholderFixed ?? "";
        const placeholderMonthly = root.dataset.placeholderMonthly ?? "";

        const template = mustQuery<HTMLTemplateElement>(
            root,
            "template[data-expense-template]",
        );
        const notice = mustQuery<HTMLElement>(root, "[data-notice]");
        const saveStatus = mustQuery<HTMLElement>(root, "[data-save-status]");
        const saveLabel = mustQuery<HTMLElement>(root, "[data-save-label]");
        const exampleNote = root.querySelector<HTMLElement>(
            "[data-example-note]",
        );

        const nameA = mustQuery<HTMLInputElement>(root, '[data-name="a"]');
        const nameB = mustQuery<HTMLInputElement>(root, '[data-name="b"]');
        const incomeA = mustQuery<HTMLInputElement>(root, '[data-income="a"]');
        const incomeB = mustQuery<HTMLInputElement>(root, '[data-income="b"]');
        const currency = mustQuery<HTMLSelectElement>(root, "[data-currency]");

        let storageWorks = true;
        let state = loadState();
        let saveTimer: ReturnType<typeof setTimeout> | undefined;

        syncFields();
        renderExpenses();
        update();
        saveNow();
        root.dataset.hydrated = "true";

        root.addEventListener("input", handleInput);
        root.addEventListener("click", handleClick);
        window.addEventListener("pagehide", saveNow);

        function loadState(): CoupleExpenseState {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (!raw) return createExampleState(locale);
                return normalizeState(JSON.parse(raw), locale);
            } catch {
                storageWorks = false;
                return createExampleState(locale);
            }
        }

        function syncFields() {
            nameA.value = state.nameA;
            nameB.value = state.nameB;
            incomeA.value = state.incomeA ? String(state.incomeA) : "";
            incomeB.value = state.incomeB ? String(state.incomeB) : "";
            currency.value = state.currency;
            syncSymbols();
        }

        function syncSymbols() {
            const symbol = getCurrencySymbol(state.currency);

            root.querySelectorAll<HTMLElement>(
                "[data-currency-symbol]",
            ).forEach((element) => {
                element.textContent = symbol;
            });
        }

        function renderExpenses() {
            for (const listName of ["fixed", "monthly"] as const) {
                const list = mustQuery<HTMLElement>(
                    root,
                    `[data-list="${listName}"]`,
                );
                list.replaceChildren();

                for (const expense of state[listName]) {
                    const row = template.content.firstElementChild?.cloneNode(
                        true,
                    ) as HTMLElement | undefined;

                    if (!row) continue;

                    row.dataset.id = expense.id;

                    const nameInput = mustQuery<HTMLInputElement>(
                        row,
                        "[data-expense-name]",
                    );
                    const amountInput = mustQuery<HTMLInputElement>(
                        row,
                        "[data-expense-amount]",
                    );

                    nameInput.value = expense.name;
                    nameInput.placeholder =
                        listName === "fixed"
                            ? placeholderFixed
                            : placeholderMonthly;
                    amountInput.value = expense.amount
                        ? String(expense.amount)
                        : "";

                    const symbol = mustQuery<HTMLElement>(
                        row,
                        "[data-currency-symbol]",
                    );
                    symbol.textContent = getCurrencySymbol(state.currency);

                    list.append(row);
                }

                const empty = root.querySelector<HTMLElement>(
                    `[data-empty="${listName}"]`,
                );
                if (empty) empty.hidden = state[listName].length > 0;
            }
        }

        function handleInput(event: Event) {
            const target = event.target;
            if (!(
                target instanceof HTMLInputElement ||
                target instanceof HTMLSelectElement
            )) {
                return;
            }

            if (target.matches('[data-name="a"]')) {
                state.nameA = target.value.slice(0, 32);
            } else if (target.matches('[data-name="b"]')) {
                state.nameB = target.value.slice(0, 32);
            } else if (target.matches('[data-income="a"]')) {
                state.incomeA = parseAmount(target.value);
            } else if (target.matches('[data-income="b"]')) {
                state.incomeB = parseAmount(target.value);
            } else if (target.matches("[data-currency]")) {
                state.currency = target.value;
                syncSymbols();
            } else if (
                target.matches("[data-expense-name]") ||
                target.matches("[data-expense-amount]")
            ) {
                const row = target.closest<HTMLElement>("[data-expense-row]");
                const listName = row?.closest<HTMLElement>("[data-list]")
                    ?.dataset.list as "fixed" | "monthly" | undefined;

                if (!row || !listName) return;

                const expense = state[listName].find(
                    (item) => item.id === row.dataset.id,
                );
                if (!expense) return;

                if (target.matches("[data-expense-name]")) {
                    expense.name = target.value.slice(0, 48);
                } else {
                    expense.amount = parseAmount(target.value);
                }
            } else {
                return;
            }

            update();
            scheduleSave();
        }

        function handleClick(event: Event) {
            const target = (
                event.target as HTMLElement | null
            )?.closest<HTMLElement>("[data-add], [data-expense-remove]");

            if (!target) return;

            if (target.matches("[data-add]")) {
                const listName = target.dataset.add as "fixed" | "monthly";
                state[listName].push(createExpense("", 0));
                renderExpenses();
                update();
                focusLastExpense(listName);
                scheduleSave();
                return;
            }

            if (target.matches("[data-expense-remove]")) {
                const row = target.closest<HTMLElement>("[data-expense-row]");
                const listName = row?.closest<HTMLElement>("[data-list]")
                    ?.dataset.list as "fixed" | "monthly" | undefined;

                if (!row || !listName) return;

                state[listName] = state[listName].filter(
                    (expense) => expense.id !== row.dataset.id,
                );
                renderExpenses();
                update();
                saveNow();
            }
        }

        function focusLastExpense(listName: "fixed" | "monthly") {
            const rows = root.querySelectorAll<HTMLElement>(
                `[data-list="${listName}"] [data-expense-row]`,
            );
            const lastRow = rows[rows.length - 1];

            lastRow
                ?.querySelector<HTMLInputElement>("[data-expense-name]")
                ?.focus();
        }

        function update() {
            const result = calculateSplit(state);
            const fmt = (amount: number) =>
                formatMoney(amount, state.currency, locale);
            const pct = (value: number) => formatPercent(value, locale);

            if (exampleNote) {
                exampleNote.hidden = !isExampleState(state, locale);
            }

            const nameAValue = state.nameA.trim() || fallbackA;
            const nameBValue = state.nameB.trim() || fallbackB;

            setText(
                "[data-total-income]",
                result.hasIncome ? fmt(result.totalIncome) : "—",
            );
            setText("[data-total-expenses]", fmt(result.totalExpenses));

            const savingsRate = root.querySelector<HTMLElement>(
                "[data-savings-rate]",
            );
            if (savingsRate) {
                savingsRate.textContent =
                    result.savingsRate === null ? "—" : pct(result.savingsRate);
                savingsRate.classList.toggle(
                    "is-negative",
                    result.savingsRate !== null && result.savingsRate < 0,
                );
            }

            const effort = root.querySelector<HTMLElement>("[data-effort]");
            if (effort) {
                effort.textContent =
                    result.effort === null ? "—" : pct(result.effort);
                effort.classList.toggle("is-negative", result.overBudget);
            }

            const combinedSavings = root.querySelector<HTMLElement>(
                "[data-combined-savings]",
            );
            if (combinedSavings) {
                combinedSavings.textContent = result.hasIncome
                    ? fmt(result.combinedSavings)
                    : "—";
                combinedSavings.classList.toggle(
                    "is-negative",
                    result.combinedSavings < 0,
                );
            }

            for (const listName of ["fixed", "monthly"] as const) {
                setText(
                    `[data-list-total="${listName}"]`,
                    fmt(sumExpenses(state[listName])),
                );
            }

            updatePerson(
                "a",
                result.a,
                nameAValue,
                result.hasIncome,
                result.totalExpenses,
                fmt,
                pct,
            );
            updatePerson(
                "b",
                result.b,
                nameBValue,
                result.hasIncome,
                result.totalExpenses,
                fmt,
                pct,
            );

            const splitA =
                result.hasIncome && result.totalExpenses > 0
                    ? (result.a.contribution / result.totalExpenses) * 100
                    : 0;
            const splitB =
                result.hasIncome && result.totalExpenses > 0 ? 100 - splitA : 0;

            setBar(root.querySelector("[data-split-a]"), splitA);
            setBar(root.querySelector("[data-split-b]"), splitB);

            const incomeContribution = result.hasIncome
                ? clamp(result.effort ?? 0)
                : 0;
            setBar(
                root.querySelector("[data-split-contribution]"),
                incomeContribution,
            );
            setBar(
                root.querySelector("[data-split-savings]"),
                result.hasIncome ? Math.max(0, 100 - incomeContribution) : 0,
            );
            setText(
                "[data-income-split]",
                result.hasIncome ? fmt(result.totalIncome) : "—",
            );

            const legend = root.querySelector<HTMLElement>(
                "[data-split-legend]",
            );
            if (legend) {
                legend.textContent =
                    result.hasIncome && result.totalExpenses > 0
                        ? `${nameAValue} ${pct(splitA)} · ${nameBValue} ${pct(splitB)}`
                        : "—";
            }

            if (!result.hasIncome) {
                notice.hidden = false;
                notice.textContent = zeroIncome;
                notice.classList.remove("is-warning");
            } else if (result.overBudget) {
                notice.hidden = false;
                notice.textContent = overBudget;
                notice.classList.add("is-warning");
            } else {
                notice.hidden = true;
                notice.textContent = "";
            }
        }

        function updatePerson(
            key: "a" | "b",
            person: PersonSplit,
            name: string,
            hasIncome: boolean,
            totalExpenses: number,
            fmt: (amount: number) => string,
            pct: (value: number) => string,
        ) {
            setText(`[data-result-name="${key}"]`, name);
            setText(
                `[data-contribution="${key}"]`,
                hasIncome ? fmt(person.contribution) : "—",
            );
            setText(
                `[data-savings="${key}"]`,
                hasIncome ? fmt(person.savings) : "—",
            );

            const billShare = root.querySelector<HTMLElement>(
                `[data-bill-share="${key}"]`,
            );
            if (billShare) {
                billShare.textContent =
                    hasIncome && totalExpenses > 0
                        ? pct((person.contribution / totalExpenses) * 100)
                        : "—";
            }

            const savings = root.querySelector<HTMLElement>(
                `[data-savings="${key}"]`,
            );
            savings?.classList.toggle("is-negative", person.savings < 0);

            const card = root.querySelector<HTMLElement>(
                `[data-person-result="${key}"]`,
            );
            card?.classList.toggle("is-over", person.savings < 0);
        }

        function setText(selector: string, text: string) {
            const element = root.querySelector<HTMLElement>(selector);
            if (element) element.textContent = text;
        }

        function setBar(element: Element | null, percent: number) {
            if (!(element instanceof HTMLElement)) return;
            element.style.width = `${clamp(percent)}%`;
        }

        function clamp(value: number): number {
            return Math.min(100, Math.max(0, value));
        }

        function scheduleSave() {
            if (!storageWorks) return;

            window.clearTimeout(saveTimer);
            saveTimer = window.setTimeout(saveNow, SAVE_DELAY);
        }

        function saveNow() {
            if (!storageWorks) {
                setSaveStatus(false);
                return;
            }

            window.clearTimeout(saveTimer);

            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
                setSaveStatus(true);
            } catch {
                storageWorks = false;
                setSaveStatus(false);
            }
        }

        function setSaveStatus(ok: boolean) {
            saveStatus.classList.toggle("is-error", !ok);
            saveLabel.textContent = ok ? savedLabel : saveErrorLabel;
        }
    }

    function mustQuery<T extends Element>(
        parent: ParentNode,
        selector: string,
    ): T {
        const element = parent.querySelector<T>(selector);
        if (!element) {
            throw new Error(`Missing calculator element: ${selector}`);
        }
        return element;
    }
</script>

<style>
    .calc {
        --accent-a: var(--green);
        --accent-b: var(--blue);
        position: relative;
        margin: var(--space-2xl) 0;
        padding: clamp(20px, 4vw, 32px);
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.09);
        border-radius: var(--radius-xl);
        background:
            radial-gradient(
                circle at 0% 0%,
                rgba(6, 214, 160, 0.08),
                transparent 32%
            ),
            radial-gradient(
                circle at 100% 10%,
                rgba(17, 138, 178, 0.1),
                transparent 38%
            ),
            linear-gradient(
                180deg,
                rgba(255, 255, 255, 0.03),
                rgba(255, 255, 255, 0.01)
            ),
            var(--bg-elevated);
        box-shadow:
            0 24px 60px rgba(0, 0, 0, 0.22),
            inset 0 1px 0 rgba(255, 255, 255, 0.04);
        color-scheme: dark;
        line-height: 1.5;
    }

    .calc-header {
        max-width: 58ch;
    }

    .calc .calc-title {
        margin: 0 0 var(--space-sm);
        color: var(--text);
        font-family: "Sora", sans-serif;
        font-size: clamp(1.45rem, 3vw, 1.9rem);
        font-weight: 600;
        letter-spacing: -0.04em;
        line-height: 1.08;
    }

    .calc .calc-subtitle {
        margin: 0;
        color: var(--text-secondary);
        font-size: 0.92rem;
        line-height: 1.65;
    }

    .calc-trust {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
