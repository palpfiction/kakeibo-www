---
import type { Locale, Translations } from "../i18n";

interface Props {
    locale: Locale;
    t: Translations;
}

const { t } = Astro.props;
const f = t.faqs;

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: f.items.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
            "@type": "Answer",
            text: item.answer,
        },
    })),
};
---

<section class="section faqs" id="faqs">
    <div class="section-inner">
        <div class="section-header fade-in">
            <h2 class="section-title">{f.title}</h2>
        </div>
        <div class="faqs-list">
            {
                f.items.map((item, i) => (
                    <details
                        class="faqs-item fade-in"
                        class:list={[`fade-in-delay-${i + 1}`]}
                    >
                        <summary class="faqs-question">
                            <span>{item.question}</span>
                            <svg
                                class="faqs-chevron"
                                width="16"
                                height="16"
                                viewBox="0 0 16 16"
                                fill="none"
                                aria-hidden="true"
                            >
                                <path
                                    d="M4 6l4 4 4-4"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                />
                            </svg>
                        </summary>
                        <div class="faqs-answer">
                            <p>{item.answer}</p>
                        </div>
                    </details>
                ))
            }
        </div>
    </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
    .faqs {
        background: var(--bg);
    }

    .faqs-list {
        max-width: 640px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
    }

    .faqs-item {
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        transition: border-color var(--transition-normal);
    }

    .faqs-item[open] {
        border-color: var(--border-light);
    }

    .faqs-question {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-md);
        padding: var(--space-lg);
        cursor: pointer;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text);
        list-style: none;
        user-select: none;
    }

    .faqs-question::-webkit-details-marker {
        display: none;
    }

    .faqs-chevron {
        flex-shrink: 0;
        color: var(--subtext);
        transition: transform var(--transition-fast);
    }

    .faqs-item[open] .faqs-chevron {
        transform: rotate(180deg);
    }

    .faqs-answer {
        padding: 0 var(--space-lg) var(--space-lg);
    }

    .faqs-answer p {
        font-size: 0.9rem;
        line-height: 1.7;
        color: var(--subtext);
    }
</style>
