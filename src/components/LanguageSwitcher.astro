---
import {
    locales,
    type Locale,
    type Translations,
} from "../i18n";

interface Props {
    locale: Locale;
    t: Translations;
    /** Optional sub-path to append, e.g. "privacy" → /es/privacy/ */
    path?: string;
    /** Optional explicit href map, useful when localized slugs differ. */
    hrefs?: Partial<Record<Locale, string>>;
    /**
     * Whether the switcher is fixed-positioned (default: true).
     * Pass false when embedding inside a header.
     */
    fixed?: boolean;
}

const { locale, t, path, hrefs, fixed = true } = Astro.props;

const hrefFor = (target: Locale): string =>
    hrefs?.[target] ?? (path ? `/${target}/${path}/` : `/${target}/`);

const labelFor = (target: Locale): string =>
    target === "en" ? "English" : "Español";

const ariaFor = (target: Locale): string =>
    target === "en" ? "Switch to English" : "Cambiar a Español";
---

<nav
    class:list={["lang-switcher", { "lang-switcher--fixed": fixed }]}
    aria-label={t.languageSwitcher.label}
>
    <div class="lang-toggle">
        <svg
            class="lang-globe"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M3 12h18"></path>
            <path d="M12 3a14.5 14.5 0 0 1 3.8 9 14.5 14.5 0 0 1-3.8 9 14.5 14.5 0 0 1-3.8-9A14.5 14.5 0 0 1 12 3z"></path>
        </svg>

        <span class="lang-divider" aria-hidden="true"></span>

        {
            locales.map((target: Locale) => {
                const isActive = target === locale;
                const label = target.toUpperCase();

                return isActive ? (
                    <span
                        class="lang-option is-active"
                        aria-current="true"
                        title={labelFor(target)}
                    >
                        {label}
                    </span>
                ) : (
                    <a
                        class="lang-option"
                        href={hrefFor(target)}
                        hreflang={target}
                        aria-label={ariaFor(target)}
                        title={labelFor(target)}
                    >
                        {label}
                    </a>
                );
            })
        }
    </div>
</nav>

<style>
    .lang-switcher--fixed {
        position: fixed;
        top: var(--space-md);
        right: var(--space-md);
        z-index: 100;
    }

    .lang-toggle {
        display: inline-flex;
        align-items: center;
        gap: 2px;
        height: 34px;
        padding: 0 4px 0 10px;
        background: rgba(20, 21, 21, 0.72);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: var(--radius-pill);
        box-shadow:
            0 2px 12px rgba(0, 0, 0, 0.18),
            inset 0 1px 0 rgba(255, 255, 255, 0.04);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
    }

    .lang-globe {
        width: 14px;
        height: 14px;
        flex: none;
        color: var(--subtext);
        opacity: 0.75;
    }

    .lang-divider {
        width: 1px;
        height: 14px;
        flex: none;
        margin: 0 4px;
        background: rgba(255, 255, 255, 0.1);
    }

    .lang-option {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 34px;
        height: 26px;
        padding: 0 8px;
        border-radius: var(--radius-pill);
        font-family: "Sora", sans-serif;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        color: var(--subtext);
        text-decoration: none;
        transition:
            background-color var(--transition-fast),
            color var(--transition-fast),
            box-shadow var(--transition-fast);
    }

    .lang-option:hover {
        color: var(--text);
        background: rgba(255, 255, 255, 0.05);
    }

    .lang-option.is-active {
        color: var(--text);
        background: linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.16),
            rgba(255, 255, 255, 0.07)
        );
        box-shadow:
            0 1px 2px rgba(0, 0, 0, 0.2),
            inset 0 1px 0 rgba(255, 255, 255, 0.08);
        cursor: default;
    }

    @media (max-width: 640px) {
        .lang-switcher--fixed {
            top: var(--space-sm);
            right: var(--space-sm);
        }

        .lang-toggle {
            height: 32px;
            padding-left: 8px;
        }

        .lang-globe {
            width: 13px;
            height: 13px;
        }

        .lang-option {
            min-width: 30px;
            height: 24px;
            padding: 0 6px;
            font-size: 0.64rem;
        }
    }
</style>
